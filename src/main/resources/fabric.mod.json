{
	"schemaVersion": 1,
	"id": "macroverse",
	"version": "${version}",
	"name": "Minecraft Macroverse",
	"description": "This is an example description! Tell everyone what your mod is about!",
	"authors": [
		"VoxelDragon6 (Lead)"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "MIT",
	"icon": "assets/macroverse/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.tws.macroverse.Main"
		],
		"client": [
			"net.tws.macroverse.client.Client"
		],
		"fabric-datagen": [
			"net.tws.macroverse.client.Datagen"
		]
	},
	"mixins": [
		"macroverse.mixins.json",
		{
			"config": "macroverse.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}